{
  "expo": {
    "name": "JustReach",
    "slug": "JustReach",
    "scheme": "justreach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/asssets/images/logo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-secure-store"
    ],
    "splash": {
      "image": "./src/asssets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/asssets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "justreach.app",
      "googleServicesFile": "./config/google-services.json"
    },
    "web": {
      "favicon": "./src/asssets/images/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "9de6ac8a-971f-477c-bef5-24ab507e6ece"
      }
    }
  }
}
